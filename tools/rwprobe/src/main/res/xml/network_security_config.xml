<?xml version="1.0" encoding="utf-8"?>
<!-- Test app only: trusts user-installed CAs so WAYD's local CA can decrypt its traffic. Never copy this into a real app. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
